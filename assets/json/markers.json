{
    "markers": [
        {
            "id": "cathedrale",
            "name": "Cathédrale Sainte-Cécile d'Albi",
            "description": "La cathédrale Sainte-Cécile domine le centre historique d'Albi avec son imposante silhouette et son architecture gothique. La cathédrale Sainte-Cécile, classée avec la cité épiscopale d'Albi depuis le 31 juillet 2010 sur la liste du patrimoine mondial de l'Unesco, est aujourd'hui l'une des cathédrales les plus visitées de France.",
            "coordinates" : [43.92841, 2.14255],
            "icon": "church",
            "size": "nm"
        },
        {
            "id": "univ-champollion",
            "name" : "INU Champollion",
            "description": "L'institut universitaire Champollion est un lieu central pour la vie étudiante et culturelle d'Albi.",
            "coordinates" : [43.918654, 2.137635],
            "icon": "graduation-cap",
            "size": "nm"
        },
        {
            "id": "vieux-pont",
            "name": "Pont Vieux",
            "description": "Le Pont Vieux relie les rives du Tarn et constitue un repère historique majeur de la ville. Le Pont du Tarn, tel qu'il s'appelait à l'origine, a été construit entre 1035 et 1042. Les parties les plus anciennes visibles actuellement datent cependant du XIIIe siècle. Au départ, trop étroit, il ne permet pas le passage des charrettes. Les marchandises sont transportées à dos d'animal ou faix d'homme. Il est élargi au XIVe siècle, puis à nouveau au XIXe siècle. Il est classé monument historique depuis 1840.",
            "coordinates" : [43.93118, 2.144555],
            "icon": "bridge",
            "size": "nm"
        },
        {
            "id": "jardin-albi",
            "name": "Jardin Nationnal d'Albi",
            "description": "Le jardin national d'Albi est un espace vert de promenade et de détente au cœur de la ville.",
            "coordinates" : [43.926007, 2.147881],
            "icon": "park",
            "size": "nm"
        },
        {
            "id": "parc-rochegude",
            "name": "Parc Rochegude",
            "description": "Le parc Rochegude offre de belles vues sur Albi et sur le Tarn, avec des espaces de promenade ombragés.",
            "coordinates" : [43.921521, 2.145199],
            "icon": "park",
            "size": "nm"
        },
        {
            "id": "place-fernand-pelloutier",
            "name": "Place Fernand Pelloutier",
            "description": "La place Fernand Pelloutier est un espace de vie urbaine très fréquenté au centre d'Albi.",
            "coordinates" : [43.92564, 2.152569],
            "icon": "park",
            "size": "nm"
        },
        {
            "id": "gare-albi-madeleine",
            "name": "Gare Albi Madeleine",
            "description": "La gare Albi Madeleine est un point de passage important dans la ville et son histoire ferroviaire. Elle est mise en service en 1858 par la Compagnie des houillères et chemins de fer de Carmaux-Toulouse, avant de devenir la « gare d'Albi-Midi » de la Compagnie des chemins de fer du Midi et du Canal latéral à la Garonne (Midi). C'est, en importance, la seconde gare de voyageurs de la ville, la première étant celle d'Albi-Ville.",
            "coordinates" : [43.938149, 2.1411],
            "icon": "train",
            "size": "nm"
        },
        {
            "id": "passerelle-tarn",
            "name": "Passerelle sur le Tarn",
            "description": "La passerelle sur le Tarn offre une vue panoramique sur le fleuve et le paysage albigien.",
            "coordinates" : [43.929156, 2.138793],
            "icon": "bridge",
            "size": "nm"
        },
        {
            "id": "gendarmerie",
            "name": "Gendarmerie",
            "description": "La gendarmerie est un bâtiment administratif emblématique du patrimoine urbain d'Albi.",
            "coordinates" : [43.919566, 2.140038],
            "icon": "police-car",
            "size": "nm"
        }
    ],
